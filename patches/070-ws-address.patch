+
+    // Custom client: locked "-ws" options carry full ws-form addresses for
+    // the injected ID/relay servers. Classify by host AND port (mirroring
+    // the port arithmetic below) so deployments where ID and relay share
+    // one hostname still route relay traffic to /ws/relay.
+    let plain_id = Config::get_rendezvous_server();
+    let plain_relay = Config::get_option(OPTION_RELAY_SERVER);
+    let ws_id = Config::get_option("custom-rendezvous-server-ws");
+    let ws_relay = Config::get_option("relay-server-ws");
+    if !ws_id.is_empty() || !ws_relay.is_empty() {
+        if let Some((ep_host, ep_port)) = split_host_port(endpoint) {
+            let (id_host, id_port) = split_host_port(&plain_id)
+                .unwrap_or((plain_id.clone(), RENDEZVOUS_PORT));
+            let (relay_host, relay_port) = split_host_port(&plain_relay)
+                .unwrap_or((plain_relay.clone(), RELAY_PORT));
+            let is_id = !plain_id.is_empty()
+                && ep_host == id_host
+                && (ep_port == id_port || ep_port == id_port - 1);
+            let is_relay = !plain_relay.is_empty()
+                && ep_host == relay_host
+                && (ep_port == relay_port || ep_port == id_port + 1);
+            if is_id && !ws_id.is_empty() {
+                return ws_id;
+            }
+            if is_relay && !ws_relay.is_empty() {
+                return ws_relay;
+            }
+        }
+    }
