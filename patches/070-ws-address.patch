+// Custom client: return `ws_form` when `endpoint` points at the same host
+// as the plain-form server address `plain`. Full ws:// or wss:// URLs keep
+// their custom ports and paths instead of being rewritten to /ws/<path>.
+fn ws_override(endpoint: &str, plain: &str, ws_form: &str) -> Option<String> {
+    if ws_form.is_empty() || plain.is_empty() || endpoint.is_empty() {
+        return None;
+    }
+    if is_ws_endpoint(endpoint) {
+        return None;
+    }
+    let ep_host = split_host_port(endpoint).map(|(h, _)| h)?;
+    let plain_host = split_host_port(plain)
+        .map(|(h, _)| h)
+        .unwrap_or_else(|| plain.to_string());
+    if ep_host == plain_host {
+        Some(ws_form.to_string())
+    } else {
+        None
+    }
+}
