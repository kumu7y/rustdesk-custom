+    /**
+     * Keep Android's system back gesture from stealing swipes that belong to the
+     * remote session. Only the vertical edges are excluded: Android caps an app at
+     * 200dp per edge, and the bottom home gesture cannot be excluded at all.
+     */
+    private fun setGestureExclusion(enabled: Boolean) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return
+        val view = window?.decorView ?: return
+        if (!enabled) {
+            view.systemGestureExclusionRects = emptyList()
+            return
+        }
+        val w = view.width
+        val h = view.height
+        if (w <= 0 || h <= 0) return
+        val edge = (w * 0.06f).toInt().coerceIn(16, 200)
+        view.systemGestureExclusionRects = listOf(
+            Rect(0, 0, edge, h),
+            Rect(w - edge, 0, w, h)
+        )
+    }
